# Force LF on everything the toolchain touches. A CRLF sneaking in from a
# Windows editor produces `bad interpreter: /bin/bash^M` and Verilator parse
# errors whose messages point nowhere near the real cause.
* text=auto eol=lf

*.sv   text eol=lf
*.v    text eol=lf
*.S    text eol=lf
*.s    text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.ld   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
Makefile text eol=lf

*.hex  text eol=lf
*.vcd  binary
*.fst  binary
*.png  binary
